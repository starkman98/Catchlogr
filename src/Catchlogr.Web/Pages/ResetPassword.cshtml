@page "/reset-password"
@model Catchlogr.Web.Pages.ResetPasswordModel
@using Catchlogr.Web.Services
@{
    ViewData["Title"] = "Reset password";
}

@if (Model.Result == IdentityActionResult.Succeeded)
{
    <h1>Password reset</h1>
    <p>Your password has been changed. You can return to the Catchlogr app and sign in.</p>
}
else if (Model.Result == IdentityActionResult.Rejected &&
         (string.IsNullOrWhiteSpace(Model.Email) || string.IsNullOrWhiteSpace(Model.Code)))
{
    <h1>Unable to reset password</h1>
    <p>The password-reset link is incomplete or invalid.</p>
}
else
{
    <h1>Reset password</h1>

    @if (Model.Result == IdentityActionResult.Rejected)
    {
        <div class="alert alert-danger" role="alert">
            The link is invalid or expired, or the password does not meet the account requirements.
        </div>
    }
    else if (Model.Result == IdentityActionResult.ServiceUnavailable)
    {
        <div class="alert alert-warning" role="alert">
            Catchlogr is temporarily unavailable. Please try again in a few minutes.
        </div>
    }

    <form method="post">
        <input asp-for="Email" type="hidden" />
        <input asp-for="Code" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">New password</label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Confirm new password</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Reset password</button>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
