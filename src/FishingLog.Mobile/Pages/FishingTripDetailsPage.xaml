<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FishingLog.Mobile.Pages.FishingTripDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:entities="clr-namespace:FishingLog.Sync.Entities;assembly=FishingLog.Sync"
    xmlns:vm="clr-namespace:FishingLog.Mobile.ViewModels"
    x:DataType="vm:FishingTripDetailsViewModel"
    x:Name="page"
    Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit" Command="{Binding EditTripCommand}" Order="Primary" Priority="0" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="16">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label
                FontAttributes="Bold"
                FontSize="24"
                Text="{Binding Name}" />

            <Label
                FontSize="14"
                Text="{Binding LocationName}"
                TextColor="Gray" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                <Label Grid.Row="0" Grid.Column="0" FontAttributes="Bold" Text="Start" />
                <Label Grid.Row="0" Grid.Column="1" Text="{Binding StartDate, StringFormat='{0:MMM dd, yyyy}'}" />

                <Label Grid.Row="1" Grid.Column="0" FontAttributes="Bold" IsVisible="{Binding HasEndDate}" Text="End" />
                <Label Grid.Row="1" Grid.Column="1" IsVisible="{Binding HasEndDate}" Text="{Binding EndDate, StringFormat='{0:MMM dd, yyyy}'}" />
            </Grid>

            <Label
                FontSize="14"
                Text="{Binding Note}" />

            <Border
                IsVisible="{Binding IsWeatherAvailable}"
                Margin="0,8,0,0"
                Padding="16"
                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                Stroke="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource Gray600}}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Label
                            FontSize="38"
                            HorizontalTextAlignment="Center"
                            SemanticProperties.Description="Weather condition icon"
                            Text="{Binding WeatherIcon}"
                            VerticalTextAlignment="Center"
                            WidthRequest="52" />

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="20"
                                Text="{Binding WeatherCondition}" />
                            <Label
                                FontSize="12"
                                Text="Weather near trip start"
                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label FontSize="18" Text="🌡️" />
                            <Label FontAttributes="Bold" FontSize="15" Text="{Binding AirTemperature}" />
                            <Label FontSize="11" Text="Air" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label FontSize="18" Text="💨" />
                            <Label FontAttributes="Bold" FontSize="15" Text="{Binding WindSpeed}" />
                            <HorizontalStackLayout Spacing="4">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="26"
                                    LineHeight="0.8"
                                    Text="{Binding WindDirectionArrow}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                    VerticalTextAlignment="Center" />
                                <Label
                                    FontSize="11"
                                    Text="{Binding WindDirectionDegrees}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                    VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label FontSize="18" Text="◉" />
                            <Label FontAttributes="Bold" FontSize="15" Text="{Binding Pressure}" />
                            <Label FontSize="11" Text="Pressure" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource Gray600}}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label
                            FontSize="11"
                            Text="{Binding WeatherSampleTime}"
                            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        <Label
                            Grid.Column="1"
                            FontSize="11"
                            HorizontalTextAlignment="End"
                            SemanticProperties.Hint="Opens the weather provider website"
                            Text="{Binding WeatherAttribution}"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenWeatherProviderCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label
                FontAttributes="Bold"
                FontSize="18"
                Text="{Binding CatchesCount, StringFormat='Catches ({0})'}"
                VerticalOptions="Center" />

            <Button
                Grid.Column="1"
                Command="{Binding AddCatchCommand}"
                Text="Add Catch" />
        </Grid>

        <RefreshView Grid.Row="2" Command="{Binding SyncCommand}" IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
            <CollectionView ItemsSource="{Binding Catches}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label
                        HorizontalTextAlignment="Center"
                        Text="No catches added yet."
                        TextColor="Gray"
                        VerticalOptions="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:CatchLocalEntity">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem
                                        BackgroundColor="Red"
                                        Command="{Binding Source={x:Reference page}, Path=BindingContext.DeleteCatchCommand}"
                                        CommandParameter="{Binding .}"
                                        Text="Delete" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Grid Padding="0,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference page}, Path=BindingContext.SelectCatchCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding Species}" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    FontSize="13"
                                    Text="{Binding CaughtAt, StringFormat='{0:MMM dd, yyyy HH:mm}'}"
                                    TextColor="Gray" />

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    FontSize="13"
                                    Text="{Binding BaitName}"
                                    TextColor="Gray" />

                                <BoxView
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Grid.RowSpan="3"
                                    WidthRequest="8"
                                    HeightRequest="8"
                                    CornerRadius="4"
                                    Color="Orange"
                                    IsVisible="{Binding IsDirty}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
