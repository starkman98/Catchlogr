<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FishingLog.Mobile.Pages.AddEditFishingTripPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:locationDtos="clr-namespace:FishingLog.Contracts.LocationDTOs;assembly=FishingLog.Contracts"
    xmlns:vm="clr-namespace:FishingLog.Mobile.ViewModels"
    x:Name="Page"
    x:DataType="vm:AddEditFishingTripViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="6">

            <!--  Name  -->
            <Label FontAttributes="Bold" Text="Name *" />
            <Entry Placeholder="e.g. Morning session at the lake" Text="{Binding Name}" />

            <!--  Location  -->
            <Label FontAttributes="Bold" Margin="0,10,0,0" Text="Location" />
            <Entry Placeholder="e.g. Lake Vänern" Text="{Binding LocationName}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                <Button
                    Grid.Column="0"
                    Command="{Binding CaptureCurrentLocationCommand}"
                    IsEnabled="{Binding IsLocationActionIdle}"
                    Text="Use current location" />
                <Button
                    Grid.Column="1"
                    Command="{Binding SearchLocationCommand}"
                    IsEnabled="{Binding IsLocationActionIdle}"
                    Text="Search by name" />
            </Grid>
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <ActivityIndicator
                    Grid.Column="0"
                    HeightRequest="24"
                    HorizontalOptions="Start"
                    IsRunning="{Binding IsLocating}"
                    IsVisible="{Binding IsLocating}"
                    VerticalOptions="Center"
                    WidthRequest="24" />
                <ActivityIndicator
                    Grid.Column="1"
                    HeightRequest="24"
                    HorizontalOptions="Start"
                    IsRunning="{Binding IsSearchingLocation}"
                    IsVisible="{Binding IsSearchingLocation}"
                    VerticalOptions="Center"
                    WidthRequest="24" />
                <Button
                    Grid.Column="2"
                    Command="{Binding ClearLocationCommand}"
                    HorizontalOptions="End"
                    IsEnabled="{Binding IsLocationActionIdle}"
                    IsVisible="{Binding IsLocationCaptured}"
                    Text="Clear coordinates" />
            </Grid>
            <Label
                FontSize="12"
                Opacity="0.7"
                Text="{Binding LocationStatus}" />
            <Label
                FontSize="10"
                Opacity="0.6"
                Text="Searching uses only the entered name, not your device position." />
            <Label
                FontSize="12"
                Opacity="0.7"
                Text="{Binding LocationSearchStatus}" />

            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding LocationSearchResults}"
                IsVisible="{Binding HasLocationSearchResults}"
                Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="locationDtos:LocationSearchResult">
                        <Button
                            Command="{Binding BindingContext.SelectLocationSearchResultCommand, Source={x:Reference Page}}"
                            CommandParameter="{Binding .}"
                            HorizontalOptions="Fill"
                            Text="{Binding DisplayName}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label
                FontSize="10"
                IsVisible="{Binding HasLocationSearchResults}"
                Opacity="0.6"
                Text="Search powered by LocationIQ · © OpenStreetMap contributors" />

            <!--  Start date + time  -->
            <Label FontAttributes="Bold" Margin="0,10,0,0" Text="Start Date" />
            <DatePicker Date="{Binding StartDate}" />

            <Label FontAttributes="Bold" Margin="0,6,0,0" Text="Start Time" />
            <TimePicker Time="{Binding StartTimeOfDay}" />

            <!--  End date (optional)  -->
            <HorizontalStackLayout Margin="0,10,0,0" Spacing="8">
                <CheckBox IsChecked="{Binding HasEndDate}" VerticalOptions="Center" />
                <Label Text="Trip has ended" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <DatePicker Date="{Binding EndDate}" IsEnabled="{Binding HasEndDate}" IsVisible="{Binding IsEndDateVisible}" />

            <!--  Notes  -->
            <Label FontAttributes="Bold" Margin="0,10,0,0" Text="Notes" />
            <Editor
                AutoSize="Disabled"
                HeightRequest="120"
                Placeholder="How did it go? Any catches?"
                Text="{Binding Note}" />

            <!--  Save / Cancel  -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                <Button
                    Grid.Column="0"
                    BackgroundColor="Gray"
                    Command="{Binding CancelCommand}"
                    Text="Cancel"
                    TextColor="White" />
                <Button
                    Grid.Column="1"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsLocationActionIdle}"
                    Text="Save" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
