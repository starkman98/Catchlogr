<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Catchlogr.Mobile.Pages.CheckEmailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Catchlogr.Mobile.ViewModels"
    x:DataType="vm:CheckEmailViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout
            Margin="32"
            MaximumWidthRequest="480"
            Spacing="18"
            VerticalOptions="Center">

            <Label
                FontAttributes="Bold"
                FontSize="28"
                HorizontalTextAlignment="Center"
                Text="Check your email" />

            <Label
                HorizontalTextAlignment="Center"
                Text="Open the confirmation link we sent, then return to Catchlogr and sign in."
                TextColor="Gray" />

            <Entry
                AutomationId="ConfirmationEmailEntry"
                IsEnabled="{Binding IsNotBusy}"
                Keyboard="Email"
                Placeholder="Email address"
                Text="{Binding Email}" />

            <Label
                IsVisible="{Binding HasStatusMessage}"
                Text="{Binding StatusMessage}"
                TextColor="Green" />

            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red" />

            <Grid>
                <Button
                    AutomationId="ResendConfirmationButton"
                    Command="{Binding ResendCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="Resend confirmation email" />
                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Center" />
            </Grid>

            <Button
                AutomationId="ConfirmationOpenLoginButton"
                BackgroundColor="Transparent"
                Command="{Binding OpenLoginCommand}"
                IsEnabled="{Binding IsNotBusy}"
                Text="Back to sign in" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
