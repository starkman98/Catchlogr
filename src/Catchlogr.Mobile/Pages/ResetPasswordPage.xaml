<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Catchlogr.Mobile.Pages.ResetPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:Catchlogr.Contracts.AuthenticationDTOs;assembly=Catchlogr.Contracts"
    xmlns:vm="clr-namespace:Catchlogr.Mobile.ViewModels"
    x:DataType="vm:ResetPasswordViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout
            Margin="32"
            MaximumWidthRequest="480"
            Spacing="18"
            VerticalOptions="Center">

            <Label
                FontAttributes="Bold"
                FontSize="28"
                HorizontalTextAlignment="Center"
                Text="Enter your reset code" />

            <Label
                HorizontalTextAlignment="Center"
                Text="If the account exists, the reset code is in the email we sent."
                TextColor="Gray" />

            <Entry
                AutomationId="ResetPasswordEmailEntry"
                IsEnabled="{Binding IsNotBusy}"
                Keyboard="Email"
                Placeholder="Email address"
                ReturnType="Next"
                Text="{Binding Email}" />

            <Editor
                AutomationId="ResetPasswordCodeEntry"
                AutoSize="TextChanges"
                IsEnabled="{Binding IsNotBusy}"
                Placeholder="Reset code"
                Text="{Binding ResetCode}" />

            <Entry
                AutomationId="ResetPasswordNewPasswordEntry"
                IsEnabled="{Binding IsNotBusy}"
                IsPassword="{Binding HidePassword}"
                IsTextPredictionEnabled="False"
                IsSpellCheckEnabled="False"
                Placeholder="New password"
                ReturnType="Next"
                Text="{Binding NewPassword}" />

            <Entry
                AutomationId="ResetPasswordConfirmPasswordEntry"
                IsEnabled="{Binding IsNotBusy}"
                IsPassword="{Binding HidePassword}"
                IsTextPredictionEnabled="False"
                IsSpellCheckEnabled="False"
                Placeholder="Confirm new password"
                ReturnType="Go"
                Text="{Binding ConfirmPassword}" />

            <Label Text="{x:Static auth:PasswordRequirements.Guidance}" />

            <HorizontalStackLayout Spacing="8">
                <Switch IsToggled="{Binding HidePassword}" AutomationId="ResetPasswordHidePasswordSwitch" />
                <Label Text="Hide passwords" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label
                IsVisible="{Binding HasStatusMessage}"
                Text="{Binding StatusMessage}"
                TextColor="Green" />

            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red" />

            <Grid>
                <Button
                    AutomationId="ResetPasswordButton"
                    Command="{Binding ResetPasswordCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="Reset password" />
                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Center" />
            </Grid>

            <Button
                AutomationId="ResetPasswordOpenLoginButton"
                BackgroundColor="Transparent"
                Command="{Binding OpenLoginCommand}"
                IsEnabled="{Binding IsNotBusy}"
                Text="Back to sign in" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
