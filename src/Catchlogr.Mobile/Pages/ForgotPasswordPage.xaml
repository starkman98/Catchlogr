<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Catchlogr.Mobile.Pages.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Catchlogr.Mobile.ViewModels"
    x:DataType="vm:ForgotPasswordViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout
            Margin="32"
            MaximumWidthRequest="480"
            Spacing="18"
            VerticalOptions="Center">

            <Label
                FontAttributes="Bold"
                FontSize="28"
                HorizontalTextAlignment="Center"
                Text="Reset your password" />

            <Label
                HorizontalTextAlignment="Center"
                Text="Enter your account email and we will send a reset code if the account exists."
                TextColor="Gray" />

            <Entry
                AutomationId="ForgotPasswordEmailEntry"
                IsEnabled="{Binding IsNotBusy}"
                Keyboard="Email"
                Placeholder="Email address"
                ReturnType="Go"
                Text="{Binding Email}" />

            <Label
                IsVisible="{Binding HasErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextColor="Red" />

            <Grid>
                <Button
                    AutomationId="SendResetCodeButton"
                    Command="{Binding SendCodeCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="Send reset code" />
                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Center" />
            </Grid>

            <Button
                AutomationId="ForgotPasswordOpenLoginButton"
                BackgroundColor="Transparent"
                Command="{Binding OpenLoginCommand}"
                IsEnabled="{Binding IsNotBusy}"
                Text="Back to sign in" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
