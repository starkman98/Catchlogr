<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Catchlogr.Mobile'">
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <DefineConstants>$(DefineConstants);E2E</DefineConstants>
    <ApplicationId>com.catchlogr.e2e</ApplicationId>
    <ApplicationTitle>Catchlogr E2E</ApplicationTitle>
  </PropertyGroup>
</Project>
